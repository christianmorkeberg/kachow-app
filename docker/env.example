# Copy to docker/.env (never committed). Compose reads it for the containers' own settings.
# DB_NAME / DB_USER / DB_PASS must match the same names in kachow-app/.env, whose DB_HOST must be "db" and DB_PORT 3306.
SITE_ADDRESS=localhost
MARIADB_ROOT_PASSWORD=change-me
DB_NAME=kachow
DB_USER=kachow
DB_PASS=change-me-too
