# ── Kachow — environment configuration ───────────────────────────────────────
# Copy this file to `.env` and fill in the values. NEVER commit the real `.env`.
# (Only the variable NAMES are meaningful here; the values are placeholders.)

# ── App ──────────────────────────────────────────────────────────────────────
APP_BASE_URL=https://assistant.example.com
# 32-byte base64 key used to encrypt OAuth refresh tokens at rest (libsodium
# secretbox). Keep it STABLE forever — rotating it breaks stored tokens.
# Generate: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
APP_ENCRYPTION_KEY=

# ── Database (MySQL / MariaDB, utf8mb4) ──────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kachow
DB_USER=
DB_PASS=

# ── Google Gemini ────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional comma-separated fallbacks, cheapest last (used for light tasks like
# titling conversations and generating home-screen starters).
GEMINI_FALLBACK_MODELS=
# Caps the model's internal "thinking" tokens (the main driver of response latency).
# Blank = model default (slow); 0 = thinking off (fastest, but weaker at multi-step
# reasoning — e.g. mixing up two people's data); a positive number = token cap; -1 =
# dynamic. Sweet spot is a middle value: ~512 keeps most of the speed while restoring
# careful reasoning. Raise toward 1024 if answers slip, lower toward 256 if too slow.
# Google is retiring this numeric cap in favor of GEMINI_THINKING_LEVEL below — set
# that INSTEAD once ready (it takes priority when both are set); until then this
# still works on every model in GEMINI_MODEL / GEMINI_FALLBACK_MODELS above.
GEMINI_THINKING_BUDGET=512
# minimal / low / medium / high — the new Gemini-3-series thinking control, replacing
# the numeric budget above. Leave blank for now unless Google starts rejecting
# GEMINI_THINKING_BUDGET (it currently still works); only set this to a level your
# WHOLE model chain supports, since it applies to primary + fallbacks alike.
GEMINI_THINKING_LEVEL=
# No GEMINI_TEMPERATURE / top_p / top_k — Gemini has ignored custom sampling values
# since 3.6-flash, and newer models reject them outright, so the client sends none.
# Chat time caps (seconds). Each Gemini call is cut off after GEMINI_TIMEOUT_S and
# retried once (usually answers in ~3s); the whole turn gives up after
# GEMINI_TURN_BUDGET_S with a friendly "took too long" reply. Blank = 20 / 45.
GEMINI_TIMEOUT_S=
GEMINI_TURN_BUDGET_S=

# ── Google OAuth (Calendar + Gmail) ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://assistant.example.com/api/google-callback.php

# ── Microsoft OAuth (Outlook / Hotmail via Graph) ────────────────────────────
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=https://assistant.example.com/api/outlook-callback.php

# ── Email sending ────────────────────────────────────────────────────────────
# The assistant always drafts + waits for confirmation; this is the global lock.
EMAIL_SEND_ENABLED=false

# Outbound system mail (invites, notifications)
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=Kachow

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Generate a key pair once and keep it stable. VAPID_SUBJECT is a contact mailto.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── Discogs (vinyl collection enrichment) ────────────────────────────────────
DISCOGS_TOKEN=
DISCOGS_USER_AGENT=Kachow/1.0
